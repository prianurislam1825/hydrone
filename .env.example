# ── App Mode ─────────────────────────────────────────────────
# "local"  = no auth required, mock data, no database needed
# "cloud"  = auth required, real database, production mode
APP_MODE=local

# ── Authentication ────────────────────────────────────────────
AUTH_ENABLED=false
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── Database (only needed for APP_MODE=cloud) ─────────────────
# Format: mysql://user:password@host:port/database
DATABASE_URL=

# ── Security ──────────────────────────────────────────────────
DEVICE_TOKEN=hydrone-demo-token
DEVICE_TOKEN_SECRET=hydrone-demo-secret

# ── Rate Limiting ─────────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=600000

# ── Public (exposed to browser) ──────────────────────────────
NEXT_PUBLIC_APP_MODE=local
NEXT_PUBLIC_APP_NAME=HYDRONE
